# --- Telegram (required) ---------------------------------------------------
# WatcherDog's TALKING bot, from @BotFather. Humans talk to THIS bot (commands
# + questions); the user account below only reads/manages the farm bots.
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
# The group the bot lives in / answers in (the bot's home group id).
TELEGRAM_CHAT_ID=put-your-chat-id-here
# Optional: forum topic id if your chat uses topics. Leave blank otherwise.
TELEGRAM_THREAD_ID=

# --- Bot interface (the talking front-end — bot_interface.py) --------------
# The bot answers slash-commands + questions in BOT_GROUPS (blank = the group
# in TELEGRAM_CHAT_ID) and in private DMs, strictly READ-ONLY, using the user
# account's read tools. It also DMs the owner proactive alerts.
BOT_ENABLED=true
# Comma-separated chat ids (or public @usernames). A bot CANNOT resolve a group
# by title — use the numeric id. Blank = fall back to TELEGRAM_CHAT_ID.
BOT_GROUPS=
# Confine the bot to ONE forum topic id (it ignores other topics and never posts
# in them). Blank = no restriction; default falls back to HOURLY_REPORT_TOPIC.
BOT_TOPIC=
# Answer private DMs to the bot (read-only Q&A from anyone).
BOT_ANSWER_DMS=true
# Deliver proactive alerts as a bot DM to the owner (falls back to the user
# account if the bot can't DM — the owner must press Start on the bot once).
BOT_ALERTS=true
# Numeric user id the bot DMs alerts to. Blank = resolve IBO_CHAT_ID.
BOT_ALERT_USER_ID=
# Install WatcherDog's command menu on the bot at startup (BotFather).
BOT_SET_COMMANDS=true
# Let the bot DRIVE panels (press buttons / send commands), not just read.
# SAFETY: only BOT_ACTION_USERS can trigger actions (the bot is in an untrusted
# group). Needs AGENT_ACTIONS_ENABLED too. Recommended ON so tools actually work.
BOT_ACTIONS_ENABLED=true
# Comma-separated user ids / @usernames allowed to make the bot act.
# Blank = the owner (IBO_CHAT_ID) plus the watcher's own user account.
BOT_ACTION_USERS=
# ADMINS may tell the bot (in plain language) to grant/revoke others' access and
# to edit WatcherDog's own files. Blank = owner + own account.
BOT_ADMIN_USERS=
# Persisted agent-granted access list (so grants survive restarts).
BOT_ACCESS_PATH=data/bot_access.json
# Allow an admin to make the bot change its OWN project files (read/edit/write
# within the project root; every write is auto-backed-up). Enables self-improve.
BOT_SELF_EDIT_ENABLED=true
# Let the bot restart itself to apply code changes (validates + auto-rolls-back
# if the new code won't import or boot). Only relevant when self-edit is on.
BOT_SELF_RESTART_ENABLED=true
# Remember in-progress action tasks and resume them after a restart.
BOT_TASK_PATH=data/bot_tasks.json
BOT_TASK_MAX_RESUMES=2
# Live "On it…" status message edited with progress, then replaced by the answer.
BOT_PROGRESS_STATUS=true
# Multitasking cap: read-only turns run concurrently up to this many; action
# (panel-driving) turns still serialize among themselves.
BOT_MAX_CONCURRENT=3

# --- Telegram user-client watcher (MTProto) --------------------------------
# Required to read OTHER bots' messages (the Bot API cannot). Get the id/hash
# from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=data/watcher.session
# Group(s) to monitor: comma-separated chat ids or @usernames.
# Find ids with: .venv/bin/python tools/list_dialogs.py
WATCH_CHATS=
# How alerts are sent: "user" = as YOUR account to a real person (ALERT_USER);
# "bot" = via the watchdog bot to ALERT_CHAT_ID.
ALERT_VIA=user
# Recipient when ALERT_VIA=user: a @username, phone, or numeric id.
# "me" = your own Saved Messages. Blank defaults to "me".
ALERT_USER=
# Used only when ALERT_VIA=bot. Blank = use TELEGRAM_CHAT_ID.
ALERT_CHAT_ID=
# Also AI-check messages matching no known pattern (catches novel failures).
ANALYZE_UNKNOWN=true

# --- MCP / MTProto watcher mode (current default — run_watcher.py) ---------
# Folder of bots to proactively monitor (matched by name; the SinFermera bots
# live in "Farms"). WATCH_FOLDER_ID, if set, is a numeric folder id that wins.
WATCH_FOLDER=Farms
WATCH_FOLDER_ID=
# The chat that gets alerts and whose messages Hermes answers (id or @username).
IBO_CHAT_ID=
# Seconds between proactive sweeps of the watch folder.
WATCH_POLL_INTERVAL=120
# After reading a chat (sweep or agent), mark it read so its unread badge clears.
MARK_READ_AFTER_READ=true
# Self-contained agent that answers ibo (OpenAI-compatible chat API). The key is
# taken from AGENT_API_KEY, else OPENROUTER_API_KEY, else ~/.hermes/.env.
AGENT_MODEL=deepseek/deepseek-v4-pro
AGENT_API_BASE=https://openrouter.ai/api/v1
# AGENT_API_KEY=
# Tool-call rounds per turn. The skill-2 action loop (lookup -> screenshot ->
# read -> press -> report) needs more than a read-only Q&A; 12 is a good default.
AGENT_MAX_STEPS=12
AGENT_TIMEOUT=120

# --- GUI mode (no API: drives the real Telegram app) [LEGACY/UNUSED] -------
GUI_ALERT_CHAT=Saved Messages
GUI_SEND_ENABLED=false
GUI_SEND_KEY=return
GUI_POLL_INTERVAL=120
# Between full bot sweeps, poll JUST the alert chat this often (seconds) so a
# message you text in ibo is read and sent to Hermes within seconds.
GUI_REPLY_POLL_INTERVAL=5
GUI_SCROLL_STEPS=6
# Human-like smoothing of mouse moves / scrolling / typing (off = instant).
GUI_SMOOTH_INPUT=true
# Only open/read chats showing an unread badge (instead of every chat).
GUI_UNREAD_ONLY=true
# Also union in preview-text-change detection so a missed badge can't skip a new message.
GUI_UNREAD_FALLBACK=true
# How far right (fraction of the chat-list span) a digits-only fragment must sit to count as an unread badge.
GUI_UNREAD_X_FRAC=0.5
# Command prefix you can type from ANY account (even the one WatcherDog watches
# from) to ask Hermes a question it will reliably answer. Blank disables it.
GUI_COMMAND_PREFIX=!dog
# On startup, auto-open a stacked column of Terminal windows (activity log +
# live Hermes chat) down the right side of the screen. Set false to disable.
GUI_MONITOR_TERMINALS=true
# Where the activity log is mirrored (so you can `tail -f` it in the foreground).
GUI_RUN_LOG=data/gui_run.log
# Ignore name matches in the top this-fraction of the window when clicking a
# chat, so it never clicks the open chat's name in the HEADER (which opens the
# profile panel) instead of the chat-list row. Raise if it still hits the header.
GUI_HEADER_BAND_FRAC=0.10

# --- Hermes two-way conversation ---
HERMES_ENABLED=true
HERMES_BIN=/Users/you/.local/bin/hermes
HERMES_SESSION=watcherdog
HERMES_TIMEOUT=180

# --- Silence / heartbeat detection -----------------------------------------
# In GUI (pull) mode this reads each chat's last-message time and alerts when a
# bot has been quiet longer than the threshold (recovers when it posts again).
SILENCE_ENABLED=true
SILENCE_THRESHOLD_MINUTES=30
SILENCE_CHECK_INTERVAL_SECONDS=60
HEARTBEAT_PATH=data/heartbeats.json
EXPECTED_BOTS=

# --- Ollama (local AI analysis) --------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=huihui_ai/gemma-4-abliterated:e4b
OLLAMA_TIMEOUT=120
# Set to true to skip AI analysis entirely (forward raw errors fast).
DISABLE_AI=false

# --- Monitoring -------------------------------------------------------------
# Directory that monitored bots write their *.log files into.
LOG_DIR=logs
LOG_GLOB=*.log
POLL_INTERVAL=2.0
FLUSH_IDLE_SECONDS=5.0
DB_PATH=data/incidents.db
OFFSETS_PATH=data/offsets.json

# --- Alerting policy --------------------------------------------------------
# Only notify at or above this severity: low | medium | high | critical
MIN_SEVERITY=high
# Suppress repeats of the same error within this many seconds.
DEDUPE_WINDOW=300

# --- Hermes panels & skills (skills in docs/hermes/) ------------------------
# Folder that holds the panel control bots (one chat per panel; Panel# = the
# number in the display name). Hermes drives panels via /start + inline buttons.
PANELS_FOLDER=Panels
# Always require exactly this many launched accounts per panel (skill 4).
ACCOUNTS_PER_PANEL=4
# Minutes to let a panel's own script self-correct before Hermes takes over.
ACCOUNTS_FIX_GRACE_MINUTES=15
# Hermes runtime files (skill 2).
LEARNED_FIXES_PATH=data/hermes/learned_fixes.md
DAILY_ERRORS_PATH=data/hermes/daily_errors.jsonl
# Local time (HH:MM) to send ibo the end-of-day AI-fix summary, then clear the
# log. On startup a non-empty log (crash/reboot) is reported immediately.
DAILY_REPORT_TIME=23:59
# When true, the agent can DRIVE panels (/start, press buttons, screenshot) and
# apply fixes — not just read. Destructive buttons (Kill/Restart/Reboot/Shutdown)
# still need an explicit ibo "yes". Set false to keep the agent read-only.
AGENT_ACTIONS_ENABLED=true
# Chance (0-1) that Hermes sends a sticker after a text reply (skill 6).
STICKER_CHANCE=0.25

# --- Weekly drop stats -> Google Sheets (skill 5) --------------------------
# Wednesday 00:00: stop farms, pull Drops Stats, push to a sheet.
DROP_STATS_DIR=data/hermes/drop_stats
# Paste your Google service-account JSON at this path to enable the push.
GSHEETS_CREDENTIALS=data/hermes/drop_stats/credentials.json
GSHEETS_SHEET_ID=
GSHEETS_TAB=DropStats

# --- Recurring-error watchdog ----------------------------------------------
# Every INTERVAL seconds, if the SAME error has fired >= MIN_COUNT times within
# the trailing WINDOW, alert ibo that it keeps happening. COOLDOWN throttles
# re-alerts for the same error.
RECURRING_ERROR_ENABLED=true
RECURRING_ERROR_INTERVAL=900     # 15 minutes
RECURRING_ERROR_WINDOW=3600      # look back 1 hour
RECURRING_ERROR_MIN_COUNT=3      # "over and over" = 3+ times
RECURRING_ERROR_COOLDOWN=3600    # don't re-alert the same error within 1 hour

# --- Special Forces group (@-mention auto-reply) ---------------------------
# When this account is @-mentioned in this group, the message is handed to the
# agent (read-only) and its answer is posted back IN the group. Match by group
# title, @username, or numeric id.
SPECIAL_FORCES_ENABLED=true
SPECIAL_FORCES_CHAT=Special Forces

# --- Auto weekly digest (read-only /weekly report to ibo) ------------------
# A /weekly summary the agent compiles from the Farms folder, sent to ibo on
# WEEKDAY at HOUR (local). weekday: Mon=0 … Sun=6. Does NOT stop farms.
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_WEEKDAY=6          # Sunday
WEEKLY_DIGEST_HOUR=18           # 18:00

# --- Deterministic panel monitoring & recovery (panel_rules.py) -------------
# Master switch for the no-AI panel watch/recover engine.
PANEL_RULES_ENABLED=true
# Required launched-account count per panel.
PANEL_TARGET_ACCOUNTS=4
# Minutes a panel must stay >target before the kill+reselect+start recovery fires.
PANEL_OVERLAUNCH_MINUTES=15
# Minutes a LIVE panel's score may stay unchanged before it's treated as idle.
PANEL_IDLE_MINUTES=10
# Minutes since the panel's last status update before it's treated as down/stale.
PANEL_STALE_MINUTES=30
# Minimum seconds between actions on the same panel (debounce).
PANEL_ACTION_DEBOUNCE_SECONDS=180
# Auto-run NON-destructive recoveries (select/start/lobbies). Else post a confirm.
PANEL_AUTO_RECOVER=true
# Auto-run DESTRUCTIVE recoveries (kill all). Else always require a confirm tap.
PANEL_AUTO_DESTRUCTIVE=false
# Seconds to wait between steps of a recovery sequence.
PANEL_SETTLE_SECONDS=4
