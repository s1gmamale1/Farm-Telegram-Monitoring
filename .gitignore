# Secrets — never commit your live token
.env

# Runtime state
data/
logs/*.log

# Self-edit backups (the bot's undo files: <file>.bak.<timestamp>)
*.bak.*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Obsidian vault: keep shareable config, ignore per-user/3rd-party state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/themes/

# Agent/tooling state (machine-local, not source)
.claude-flow/
.swarm/
ruvector.db

# Test caches / coverage (regen-able)
.coverage
coverage.json
.pytest_cache/

# Local editor / MCP config (machine-local)
.cursor/
.mcp.json
