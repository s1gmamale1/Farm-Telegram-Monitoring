<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for the WatcherDog MCP/MTProto watcher (run_watcher.py).
  Proactively monitors the Farms folder and answers ibo via the self-contained
  agent. This is the current default mode.

  Prereqs: run tools/tg_login.py (authorize the user session) and set
  TELEGRAM_API_ID / API_HASH / IBO_CHAT_ID in .env, plus an OpenRouter key
  (OPENROUTER_API_KEY, also picked up from ~/.hermes/.env).

  Install:
    cp com.watcherdog.telegram.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.watcherdog.telegram.plist

  Stop / uninstall:
    launchctl unload ~/Library/LaunchAgents/com.watcherdog.telegram.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.watcherdog.telegram</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/aisigma/projects/csGrind/Farm-Telegram-Monitoring/.venv/bin/python</string>
        <string>/Users/aisigma/projects/csGrind/Farm-Telegram-Monitoring/run_watcher.py</string>
        <string>--verbose</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aisigma/projects/csGrind/Farm-Telegram-Monitoring</string>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>

    <!--
      Match the watcher's runtime launch env. Without these the launchd-supervised
      watcher would differ from the manual launch — most importantly OVERSEER_SOCKET,
      which (per config.py) defaults to empty => NO overseer socket is created.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Clear PYTHONPATH so Hermes's own `tools` package can't shadow this
             repo's `from tools import …` (the standard WatcherDog rule). -->
        <key>PYTHONPATH</key>
        <string></string>
        <!-- Expose the overseer UNIX socket (the Hermes overseer's read/drive
             endpoints). Resolved relative to WorkingDirectory. Empty/unset => no
             socket at all, so this is REQUIRED to preserve current behavior. -->
        <key>OVERSEER_SOCKET</key>
        <string>data/overseer.sock</string>
        <!-- Owner's grant: let the overseer SOCKET take destructive panel actions
             (Kill/Reboot/Shutdown, run_ladder). The watcher's OWN deterministic
             recovery is gated separately by PANEL_AUTO_DESTRUCTIVE, so flipping this
             to "false" only restricts the socket to observe/teach/resolve. -->
        <key>OVERSEER_ALLOW_DESTRUCTIVE</key>
        <string>true</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aisigma/projects/csGrind/Farm-Telegram-Monitoring/data/telegram.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aisigma/projects/csGrind/Farm-Telegram-Monitoring/data/telegram.err.log</string>
</dict>
</plist>
